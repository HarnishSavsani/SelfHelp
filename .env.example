# ── Authentication ────────────────────────────────────────────────
# Secret hash key for Chainlit token auth - MUST exist and be long/random
CHAINLIT_AUTH_SECRET=changeme_to_a_long_random_string_like_your_actual_one

# Default passwords seeded into the SQLite DB across all listed users
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_USER_PASSWORD=GenAi@2025

# ── Application Mode ──────────────────────────────────────────────
ACTIVE_LLM_PROVIDER=ollama

# ── Application Profile ──────────────────────────────────────────
# Choose a profile from profiles/ directory (without .yaml extension)
# Options: default, insurance_claims, customer_support
# Each profile defines: personality, guardrails, allowed topics, and data labels
APP_PROFILE=default

# ── Ollama Config ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.1
OLLAMA_REQUEST_TIMEOUT=120.0

# ── Azure LLM Config (If Enabled) ────────────────────────────────
AZURE_BASE_URL=https://genailab.tcs.in
AZURE_MODEL=azure_ai/genailab-maas-DeepSeek-V3-0324
AZURE_HACKATHON_API_KEY=your_azure_api_key_here
AZURE_TEMPERATURE=0.1

# ── Embedding Provider ───────────────────────────────────────────
# Options:
#   - none         (BM25-only; no model downloads)
#   - huggingface  (local SentenceTransformers; downloads once, cached)
#   - azure_custom (Azure endpoint)
ACTIVE_EMBEDDING_PROVIDER=huggingface

# HuggingFace Embedding (local - used when ACTIVE_EMBEDDING_PROVIDER=huggingface)
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5

# Azure Custom Embedding (used when ACTIVE_EMBEDDING_PROVIDER=azure_custom)
AZURE_EMBEDDING_BASE_URL=https://genailab.tcs.in
AZURE_EMBEDDING_MODEL=azure/genailab-maas-text-embedding-3-large
AZURE_EMBEDDING_API_KEY=your_azure_embedding_api_key_here

# ── RAG Tuning ────────────────────────────────────────────────────
# Set to false to disable BM25 keyword search (vector-only retrieval)
ENABLE_HYBRID_SEARCH=true
DOCUMENT_RETRIEVAL_MODE=hybrid
SHOW_SOURCES=true
